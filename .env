# Application
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# FastAPI
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/download_bot
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# Redis (optional, for FSM storage)
REDIS_URL=redis://localhost:6379/0

# Telegram Bot
TELEGRAM_BOT_TOKEN=8635159173:AAFEETFxOL-VMTmN3GkHUCZHzYkZj4j9PLc
BOT_MODE=polling
WEBHOOK_URL=https://your-domain.onrender.com
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=your_webhook_secret_here

# Telegram Limits
TG_MAX_UPLOAD_SIZE=52428800

# File Storage
DOWNLOAD_DIRECTORY=/data/downloads
TEMP_DIRECTORY=/tmp/downloads

# Download Links
DOWNLOAD_LINK_EXPIRATION=3600
DOWNLOAD_LINK_HMAC_SECRET=your_hmac_secret_at_least_32_characters_long

# Queue Settings
MAX_CONCURRENT_DOWNLOADS=3
MAX_QUEUE_SIZE=100

# Cleanup
CLEANUP_INTERVAL=3600
TEMP_FILE_TTL=86400

# Admin
ADMIN_USER_IDS=123456789,987654321

# Security
SECRET_KEY=your_secret_key_at_least_32_characters_long